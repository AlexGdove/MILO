{
  "name": "milo",
  "version": "1.0.10",
  "private": true,
  "type": "module",
  "description": "Подсчёт калорий и учёт продуктов: PWA + будущее мобильное приложение",
  "workspaces": [
    "frontend",
    "backend",
    "mobile"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run start:dev -w backend",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run build -w backend && npm run db:seed -w backend",
    "operator": "npm run build -w backend && npm run operator -w backend --",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview -w frontend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces && node --test scripts/*.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:mobile": "npm run build:web -w mobile && npm run sync -w mobile",
    "version:sync": "node scripts/version.mjs && npm install --package-lock-only --no-audit --no-fund",
    "version:patch": "node scripts/version.mjs patch && npm install --package-lock-only --no-audit --no-fund"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
