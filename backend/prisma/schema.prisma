// Схема БД backend MILO. Описание таблиц — docs/backend/database.md.
// Вне схемы (только SQL миграций): расширение pg_trgm и CHECK-ограничения.
// URL базы — в prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Unit {
  g
  ml
  pcs

  @@map("unit")
}

/// Предложение продукта: на проверке у человека / принято в общую базу / отклонено (B-18).
enum SubmissionStatus {
  pending
  approved
  rejected

  @@map("submission_status")
}

/// Кто решил: автомодерация или оператор.
enum ReviewedBy {
  auto
  operator

  @@map("reviewed_by")
}

enum ModerationActionType {
  approve_submission
  reject_submission
  block_key
  unblock_key

  @@map("moderation_action")
}

enum TicketStatus {
  open
  answered
  closed

  @@map("ticket_status")
}

enum MessageAuthor {
  user
  operator

  @@map("message_author")
}

/// Анонимный ключ устройства (B-8): один на продукты и поддержку. Сам ключ не хранится — только SHA-256.
model DeviceKey {
  id         String    @id @default(uuid()) @db.Uuid
  keyHash    String    @unique @map("key_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  blockedAt  DateTime? @map("blocked_at") @db.Timestamptz(6)

  submissions     ProductSubmission[]
  tickets         SupportTicket[]
  idempotencyKeys IdempotencyKey[]

  @@map("device_keys")
}

/// Общая база продуктов (B-18): только принятые предложения. КБЖУ — на 100 г.
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  brand       String?  @db.VarChar(80)
  /// EAN-8 / UPC-A / EAN-13 / GTIN-14 — только цифры, контрольная цифра проверяется API
  barcode     String?  @unique @db.VarChar(14)
  unit        Unit
  pieceWeight Decimal? @map("piece_weight") @db.Decimal(8, 2)
  kcal        Decimal  @db.Decimal(6, 2)
  protein     Decimal  @db.Decimal(6, 2)
  fat         Decimal  @db.Decimal(6, 2)
  carbs       Decimal  @db.Decimal(6, 2)
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  submissions ProductSubmission[]

  @@index([createdAt(sort: Desc), id])
  /// Поиск по подстроке названия (ILIKE) — триграммы, расширение pg_trgm
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

/// Предложение продукта от устройства (B-18). Автомодерация решает сразу; сомнительное — оператору.
model ProductSubmission {
  id          String           @id @default(uuid()) @db.Uuid
  deviceKeyId String           @map("device_key_id") @db.Uuid
  name        String           @db.VarChar(120)
  brand       String?          @db.VarChar(80)
  barcode     String?          @db.VarChar(14)
  unit        Unit
  pieceWeight Decimal?         @map("piece_weight") @db.Decimal(8, 2)
  kcal        Decimal          @db.Decimal(6, 2)
  protein     Decimal          @db.Decimal(6, 2)
  fat         Decimal          @db.Decimal(6, 2)
  carbs       Decimal          @db.Decimal(6, 2)
  status      SubmissionStatus @default(pending)
  /// Коды замечаний автомодерации (`automod.ts`), например `energy_mismatch`
  flags       String[]         @default([])
  reviewedBy  ReviewedBy?      @map("reviewed_by")
  reviewedAt  DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  /// Принятое предложение → продукт общей базы (новый или уже существующий)
  productId   String?          @map("product_id") @db.Uuid
  createdAt   DateTime         @map("created_at") @db.Timestamptz(6)

  deviceKey         DeviceKey             @relation(fields: [deviceKeyId], references: [id], onDelete: Cascade)
  product           Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  moderationActions ModerationAction[]
  telegramLinks     TelegramMessageLink[]

  @@index([deviceKeyId, createdAt(sort: Desc), id])
  @@index([status, createdAt])
  @@index([barcode])
  @@map("product_submissions")
}

/// Оператор в Telegram (B-10): поддержка и модерация. Добавляется командой сервера, не через API.
model Operator {
  id             String   @id @default(uuid()) @db.Uuid
  telegramUserId BigInt   @unique @map("telegram_user_id")
  displayName    String   @map("display_name") @db.VarChar(64)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actions  ModerationAction[]
  messages SupportMessage[]

  @@map("operators")
}

/// Журнал действий операторов; переживает удаление предложения и ключа.
model ModerationAction {
  id           String               @id @default(uuid()) @db.Uuid
  operatorId   String               @map("operator_id") @db.Uuid
  submissionId String?              @map("submission_id") @db.Uuid
  deviceKeyId  String?              @map("device_key_id") @db.Uuid
  action       ModerationActionType
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  operator   Operator           @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  submission ProductSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@map("moderation_actions")
}

/// Анонимное обращение в поддержку (B-10).
model SupportTicket {
  id          String       @id @default(uuid()) @db.Uuid
  number      Int          @unique @default(autoincrement())
  deviceKeyId String       @map("device_key_id") @db.Uuid
  status      TicketStatus @default(open)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  deviceKey     DeviceKey             @relation(fields: [deviceKeyId], references: [id], onDelete: Cascade)
  messages      SupportMessage[]
  telegramLinks TelegramMessageLink[]

  @@index([deviceKeyId, updatedAt(sort: Desc)])
  @@map("support_tickets")
}

model SupportMessage {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  author     MessageAuthor
  operatorId String?       @map("operator_id") @db.Uuid
  text       String        @db.VarChar(4000)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  operator Operator?     @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt, id])
  @@map("support_messages")
}

/// Сообщение бота в чате операторов → обращение (бот поддержки) или предложение (бот модерации).
model TelegramMessageLink {
  chatId       BigInt   @map("chat_id")
  messageId    Int      @map("message_id")
  ticketId     String?  @map("ticket_id") @db.Uuid
  submissionId String?  @map("submission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket     SupportTicket?     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  submission ProductSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@id([chatId, messageId])
  @@map("telegram_message_links")
}

/// Дедупликация обновлений Telegram; строки старше 7 дней удаляются. Номера обновлений у
/// каждого бота свои, поэтому ключ — бот и номер.
model TelegramUpdate {
  bot        TelegramBot @default(support)
  updateId   BigInt      @map("update_id")
  receivedAt DateTime    @default(now()) @map("received_at") @db.Timestamptz(6)

  @@id([bot, updateId])
  @@map("telegram_updates")
}

/// Боты (B-18): поддержка и модерация — свои токены и чаты операторов.
enum TelegramBot {
  support
  moderation

  @@map("telegram_bot")
}

/// Исходящие события (ADR-0003), пишутся в одной транзакции с изменением.
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(64)
  payload     Json      @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(500)
  /// Не раньше этого времени — следующая попытка (пауза растёт после каждой ошибки)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)

  /// Выборка неотправленных событий по порядку
  @@index([processedAt, createdAt])
  @@map("outbox_events")
}

/// Сохранённые ответы на POST с заголовком Idempotency-Key; строки старше 24 ч удаляются.
model IdempotencyKey {
  deviceKeyId String   @map("device_key_id") @db.Uuid
  key         String   @db.VarChar(64)
  requestHash String   @map("request_hash") @db.Char(64)
  statusCode  Int      @map("status_code") @db.SmallInt
  response    Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  deviceKey DeviceKey @relation(fields: [deviceKeyId], references: [id], onDelete: Cascade)

  @@id([deviceKeyId, key])
  @@map("idempotency_keys")
}

/// Ошибки приложения у пользователей (решение №62): одинаковые ошибки объединены по отпечатку
/// (вид + текст без чисел + верх стека + версия приложения). Личных данных нет; строки без новых
/// повторов 30 дней удаляются.
model ClientError {
  id          String   @id @default(uuid()) @db.Uuid
  fingerprint String   @unique @db.Char(64)
  /// error | unhandledrejection | render
  kind        String   @db.VarChar(20)
  message     String   @db.VarChar(500)
  stack       String?  @db.VarChar(4000)
  /// web | android | ios
  platform    String   @db.VarChar(10)
  appVersion  String   @map("app_version") @db.VarChar(16)
  /// Путь страницы без параметров (`/pantry`)
  route       String?  @db.VarChar(200)
  userAgent   String?  @map("user_agent") @db.VarChar(300)
  count       Int      @default(1)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  @@index([lastSeenAt])
  @@map("client_errors")
}

/// Тариф аккаунта (решение №68): бесплатный / платный с лимитом фото-ИИ / безлимитный.
enum Plan {
  free
  plus
  unlimited

  @@map("plan")
}

/// Аккаунт (решения №60, №68): только почта и тариф — личные данные остаются на устройстве.
model Account {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique @db.VarChar(254)
  plan        Plan      @default(free)
  planUntil   DateTime? @map("plan_until") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  blockedAt   DateTime? @map("blocked_at") @db.Timestamptz(6)

  sessions Session[]

  @@map("accounts")
}

/// Одноразовый код входа по почте. Хранится только HMAC кода; связи с аккаунтом нет — код
/// приходит и на новую почту (аккаунт создаётся при первом входе).
model LoginCode {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @db.VarChar(254)
  codeHash   String    @map("code_hash") @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("login_codes")
}

/// Сессия входа: хранится только SHA-256 токена. Срок продлевается при активности (90 дней).
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}
