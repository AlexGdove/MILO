# Пример настроек backend MILO. Скопировать в .env (не коммитится) и поправить.

# PostgreSQL из compose.yaml (`npm run db:up`); пароль — только для локальной разработки
DATABASE_URL=postgresql://milo:milo@localhost:5432/milo
# База для автотестов (по умолчанию — milo_test в том же контейнере)
# TEST_DATABASE_URL=postgresql://milo:milo@localhost:5432/milo_test

# Redis из compose.yaml: счётчики лимитов запросов
REDIS_URL=redis://localhost:6379/0
# Redis для автотестов (по умолчанию — база 1; тесты её очищают, база 0 запрещена)
# TEST_REDIS_URL=redis://localhost:6379/1

# Сколько прокси стоит перед сервером (0 — нет; X-Forwarded-For тогда не учитывается)
TRUST_PROXY=0

# Служебные маршруты локальной разработки (ответ «как оператор»: npm run support:reply -w backend).
# Запрещено в production — сервер не стартует
# DEV_TOOLS=true

# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Адреса фронтенда через запятую (CORS). На сервере — адрес PWA и мобильного приложения:
# https://<домен PWA>,https://localhost,capacitor://localhost (Android, iOS)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Swagger UI на /api/docs (по умолчанию: включён везде, кроме production)
# SWAGGER_ENABLED=true

# Telegram-боты (этап 9): токены — от @BotFather, только здесь (в git и в чат не попадают).
# Чат операторов — группа с ботом; номер узнаётся командой /id в группе (у групп он
# отрицательный). Без токена бот не запускается, без чата — отвечает только на /id.
# Одна группа с темами для обоих ботов (B-23): одинаковый CHAT_ID, у каждого бота своя тема
# (THREAD_ID — команда /id@<бот> в теме). Без THREAD_ID бот работает во всём чате.
# Локально — отдельные тестовые боты в backend/.env.dev (читается раньше .env, в git и на сервер
# не попадает): так локальный `npm run dev` не отбирает сообщения у серверных ботов (long polling).
# Операторы: npm run operator -- add <Telegram ID> <Имя>
# TELEGRAM_SUPPORT_BOT_TOKEN=
# TELEGRAM_SUPPORT_CHAT_ID=
# TELEGRAM_SUPPORT_THREAD_ID=
# TELEGRAM_MODERATION_BOT_TOKEN=
# TELEGRAM_MODERATION_CHAT_ID=
# TELEGRAM_MODERATION_THREAD_ID=
# Тема для сообщений об ошибках приложения (бот поддержки); без неё — тема поддержки
# TELEGRAM_ERRORS_THREAD_ID=

# Аккаунты (№60, №68). Секрет HMAC кодов входа — не короче 32 символов
# (openssl rand -base64 48). Вне production без него создаётся случайный при запуске.
# AUTH_CODE_SECRET=
# Отправка кодов: log — в лог сервера (только разработка; в production запрещено).
# Вне production по умолчанию log. В production без секрета и отправки вход выключен (503).
# EMAIL_TRANSPORT=log
