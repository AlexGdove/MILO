# Настройки сервера MILO для compose.prod.yaml. На VPS: cp .env.example .env и заполнить.
# Файл .env не попадает в git. Локальная разработка этот файл не использует (см. backend/.env).

# Домен сайта и API (DNS-запись A → IP сервера). Для локальной проверки — localhost
DOMAIN=milo.example.ru

# Пароль PostgreSQL: только буквы и цифры (он входит в адрес базы). Сгенерировать:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Telegram-боты (B-21): токены от @BotFather, номера групп — команда /id в группе.
# Одна группа с темами (B-23): одинаковый CHAT_ID и у каждого бота своя тема (THREAD_ID)
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=
TELEGRAM_SUPPORT_THREAD_ID=
TELEGRAM_MODERATION_BOT_TOKEN=
TELEGRAM_MODERATION_CHAT_ID=
TELEGRAM_MODERATION_THREAD_ID=
